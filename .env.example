# Copy this file to .env.local and fill in your values

# Neon PostgreSQL connection string
DB_URL=postgresql://user:password@host/dbname?sslmode=require

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Public URL of this Next.js server (the Expo app points here)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Storage provider: "dropin" or "local"
STORAGE_PROVIDER=dropin

# Dropin CDN API credentials
DROPIN_HOST=https://dropin.cognixai.cloud
DROPIN_ACCESS_KEY=
DROPIN_ACCESS_KEY_ID=
DROPIN_API_KEY=
